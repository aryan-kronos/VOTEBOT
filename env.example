# ================================================================
# 🤖 MODULAR TELEGRAM GIVEAWAY & VOTING BOT - CONFIGURATION
# ================================================================
# Copy this file to '.env' and enter your custom branding & values.

# ----------------- TELEGRAM BOT CREDENTIALS ----------------- #
# Bot Token from Telegram @BotFather
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxyz

# Bot Username (without the '@' symbol)
BOT_USERNAME=YourVoteBot

# --------------------- ADMIN & ROLES ------------------------ #
# Comma-separated list of Telegram User IDs who have Owner/Admin rights
ADMINS=233444460,8295433038,8021449673

# ----------------- DATABASE CONFIGURATION ------------------- #
# MongoDB connection URI (e.g. MongoDB Atlas Cluster or local MongoDB)
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority

# Database Name inside MongoDB
DATABASE_NAME=Votebot

# ----------------- LOGGING & NOTIFICATIONS ------------------ #
# Channel ID where the bot posts administrative and creation logs (e.g. -100xxxxxxxxxx)
LOG_CHANNEL_ID=-1001234567890

# Optional: Main Force-Sub Channel ID & Log Group
CHANNEL_ID=-1001234567890
LOG_GROUP_ID=-1001234567890

# ----------------- BRANDING & IDENTITY ---------------------- #
# Main Brand Name (Used across text templates)
BRAND_NAME=BITZ

# Brand Name in Small-Caps styling (e.g. ʙɪᴛᴢ)
BRAND_NAME_SMALLCAPS=ʙɪᴛᴢ

# Bot Name for headers & titles
BOT_NAME=BITZ GIVEAWAY BOT

# Bot Styled Header (Unicode bold / styled font for /start welcome header)
BOT_NAME_STYLED=𝐁𝐈𝐓𝐙 𝐆𝐈𝐕𝐄𝐀𝐖𝐀𝐘 𝐁𝐎𝐓!

# ----------------- BOT PROFILE & ABOUT ---------------------- #
# Custom Tagline shown in the bot's start description box
BOT_TAGLINE=Fair & Automated Giveaway Bot\n!ᵎ! TRUST • POWER • INNOVATION ✦

# Optional: Fully custom description (Developer credit will be automatically locked in)
# CUSTOM_BOT_DESCRIPTION=Your custom description text here

# ----------------- NETWORK & CHANNELS ----------------------- #
# Name of your community or announcement network
NETWORK_NAME=ʙɪᴛᴢ ɴᴇᴛᴡᴏʀᴋ

# Username of your channel (without '@')
NETWORK_USERNAME=tgbitz

# Direct link to your network channel (Default: https://t.me/NETWORK_USERNAME)
NETWORK_URL=https://t.me/tgbitz

# ----------------- SUPPORT & ADMIN CONTACT ------------------ #
# Name of Support Lead / Admin
SUPPORT_NAME=ᴅᴇᴠᴀɴꜱʜ

# Telegram Username for Support
SUPPORT_USERNAME=tgbitz_op

# Direct Link to Support Contact (Default: https://t.me/SUPPORT_USERNAME)
SUPPORT_URL=https://t.me/tgbitz_op

# ----------------- TUTORIALS & GUIDES ----------------------- #
# Link opened when user taps "How to Use" button on /start
HOW_TO_USE_URL=https://t.me/tgbitz

# ----------------- PAYMENTS & VIP PRICING ------------------- #
# Default UPI ID for VIP memberships & dynamic payment QR codes
DEFAULT_UPI_ID=devanshsingh2@fam

# Default VIP Membership Plans
# Format: DayCount Price DayCount Price... (e.g. 7D 49 15D 89 30D 149)
DEFAULT_PLANS=7D 49 15D 89 30D 149

# ----------------- ASSETS & DEFAULT IMAGES ------------------ #
# Fallback Welcome Banner image URL (if local assets/welcome.jpg is not found)
DEFAULT_WELCOME_IMAGE_URL=https://files.catbox.moe/27qumy.jpg

# Default Voting Post image URL
VOTE_IMAGE_URL=https://files.catbox.moe/mkfcpr.jpg

# Default Participant banner image URL
PARTICIPANT_IMAGE_URL=https://files.catbox.moe/27qumy.jpg
